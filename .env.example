# MusicBrainz requires a descriptive User-Agent with a real contact.
USER_AGENT=chopsongs/0.1 ( you@example.com )

# Local cache (responses and rate-limit protection).
DATA_DIR=data
CACHE_TTL_SECONDS=2592000

# How many sample expansion rounds to run: 0 disables, 3 is the maximum.
REPORT_DEPTH=2

# Groq (free tier). No fallback: 429s and provider errors are shown to the user.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Langfuse Cloud tracing (optional). Leave the keys empty to disable tracing.
# Traces contain only metadata: never song lyrics, Wikipedia text or prompts.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
