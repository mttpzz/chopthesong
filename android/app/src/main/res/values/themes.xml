<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Fixed dark theme: the site has no light mode, so the system bars must not follow it. -->
    <style name="Theme.ChopTheSong" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:navigationBarColor">@color/app_background</item>
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
